[Unit]
Description=lobster-farm run-dev loop service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lobster
WorkingDirectory=/opt/lobster-farm
ExecStartPre=/bin/bash /opt/lobster-farm/scripts/vm/prepare-systemd-env.sh
EnvironmentFile=-/opt/lobster-farm/data/runtime/run-dev/systemd.env
Environment=PYTHONUNBUFFERED=1
Environment=LOBSTER_FAILURE_ALERT_THRESHOLD=3
Environment=LOBSTER_RUN_INTERVAL_SECONDS=300
ExecStart=/bin/bash /opt/lobster-farm/scripts/vm/run-dev-service.sh
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
